-- Updated schema with security & versioning improvements

create extension if not exists "uuid-ossp";

-- Enum for story types (prevents junk values)
create type public.story_type as enum (
  'fireside',
  'kitchen',
  'bedtime',
  'chronicle'
);

create table public.profiles (
  id uuid references auth.users on delete cascade primary key,
  display_name text,
  preferred_beverage text check (preferred_beverage in ('coffee', 'tea', 'either')) default 'either',
  cultural_notes text,
  hearth_level integer not null default 1 check (hearth_level >= 1 and hearth_level <= 20),
  scene_prefs jsonb not null default '{}'::jsonb,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table public.people (
  id uuid primary key default uuid_generate_v4(),
  user_id uuid references public.profiles(id) on delete cascade not null,
  name text not null check (char_length(name) <= 200),
  relationship text check (char_length(relationship) <= 200),
  birth_year integer,
  notes text check (char_length(notes) <= 2000),
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table public.stories (
  id uuid primary key default uuid_generate_v4(),
  user_id uuid references public.profiles(id) on delete cascade not null,
  person_id uuid references public.people(id) on delete set null,
  title text check (char_length(title) <= 300),
  original_text text not null check (char_length(original_text) <= 12000),
  story_type public.story_type not null,
  generated_text text,
  context_notes text check (char_length(context_notes) <= 3000),
  metadata jsonb not null default '{}'::jsonb,
  is_favorite boolean not null default false,
  is_archived boolean not null default false,
  token_usage jsonb,                     -- optional cost tracking
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

-- Version history so regenerations never destroy a family record
create table public.story_versions (
  id uuid primary key default uuid_generate_v4(),
  story_id uuid references public.stories(id) on delete cascade not null,
  generated_text text not null,
  story_type public.story_type not null,
  created_at timestamptz not null default now()
);

create table public.hearth_events (
  id uuid primary key default uuid_generate_v4(),
  user_id uuid references public.profiles(id) on delete cascade not null,
  event_type text not null,
  details jsonb,
  created_at timestamptz not null default now()
);

-- Automatic updated_at
create or replace function public.set_updated_at()
returns trigger as $$
begin
  new.updated_at = now();
  return new;
end;
$$ language plpgsql;

create trigger profiles_updated_at
  before update on public.profiles
  for each row execute function public.set_updated_at();

create trigger people_updated_at
  before update on public.people
  for each row execute function public.set_updated_at();

create trigger stories_updated_at
  before update on public.stories
  for each row execute function public.set_updated_at();

-- Indexes
create index stories_user_created_idx on public.stories (user_id, created_at desc);
create index story_versions_story_id_idx on public.story_versions (story_id);
create index people_user_id_idx on public.people (user_id);

-- RLS (already enabled in previous version – keep and verify)
alter table public.profiles enable row level security;
alter table public.people enable row level security;
alter table public.stories enable row level security;
alter table public.story_versions enable row level security;
alter table public.hearth_events enable row level security;

-- Policies remain the same: users can only touch their own rows
